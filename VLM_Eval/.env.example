# ============================================================================
# VLM_Eval configuration — copy to `.env` and fill in your keys.
#   cp .env.example .env
# The real .env is git-ignored. NEVER commit real keys.
# ============================================================================

# --- BytePlus Seed (ModelArk / Ark, OpenAI-compatible Chat Completions) ------
SEED_API_KEY=
SEED_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEED_MODEL=dola-seed-2-1-turbo-260628

# --- Google Gemini (OpenAI-compatible endpoint) ------------------------------
# Default base URL is Google AI Studio's OpenAI-compatible surface.
# For Vertex AI, point GEMINI_BASE_URL at your Vertex OpenAI-compat endpoint.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.1-pro-preview

# --- Judge (LLM-as-judge for open-ended tasks) -------------------------------
# Which configured provider grades open-ended answers: "gemini" or "seed".
# (A judge is only used for tasks without deterministic ground truth.)
JUDGE_PROVIDER=gemini

# --- Fair-shot defaults for Seed on structured/JSON tasks ---------------------
# The customer benchmark saw Seed return valid JSON on only ~59% of calls
# because thinking-mode stalled (up to 32s) and truncated JSON. These settings
# give Seed a fair shot without changing the vision task itself.
#   SEED_THINKING: disabled | enabled | auto   (disabled = fastest, most reliable JSON)
SEED_THINKING=disabled
# Per-request wall-clock timeout in seconds (applies to both providers).
REQUEST_TIMEOUT=120
# Retries on transport error / invalid-JSON for structured tasks.
MAX_RETRIES=2
