# ─────────────────────────────────────────────────────────────────────────────
# Seedance 2.5 Ad Studio — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Bearer API Key (Seedream image + Seedance video) ─────────────────────────
# ModelArk Console → API Keys
ARK_API_KEY=your_api_key_here

# ── Asset Library (HMAC-SHA256 AK/SK) ────────────────────────────────────────
# BytePlus Console → Access Keys. Needed for CreateAsset / GetAsset.
ARK_AK=your_access_key_id_here
ARK_SK=your_secret_access_key_here

# ── Model IDs (or your inference endpoint ids, ep-xxxx) ───────────────────────
# Seedream 5.0 pro — image generation & editing
SEEDREAM_MODEL_ID=your_seedream_5_0_pro_model_or_endpoint_id
# Seedance 2.5 — video generation
SEEDANCE_MODEL_ID=your_seedance_2_5_model_or_endpoint_id

# ── Asset group used to upload/read keyframes ────────────────────────────────
ASSET_GROUP_ID=group-20260401144336-bmrf4

# ── Optional endpoint overrides (defaults target ap-southeast) ───────────────
# IMAGE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# VIDEO_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# ASSET_HOST=ark.ap-southeast-1.byteplusapi.com
# ASSET_REGION=ap-southeast-1

# ── Server settings ──────────────────────────────────────────────────────────
PORT=5060
FLASK_DEBUG=true
