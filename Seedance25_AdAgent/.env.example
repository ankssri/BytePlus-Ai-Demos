# ─────────────────────────────────────────────────────────────────────────────
# Seedance 2.5 Ad Agent — environment. Copy to `.env` and fill in.
# NEVER commit `.env` (gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# Bearer API key (Seedream + Seedance + Seed LLM; also TTS if same platform)
ARK_API_KEY=your_api_key_here

# Asset Library (HMAC AK/SK) — needed to register omni-reference assets
ARK_AK=your_access_key_id_here
ARK_SK=your_secret_access_key_here

# Model / endpoint ids
SEEDREAM_MODEL_ID=your_seedream_5_0_pro_model_or_endpoint_id
SEEDANCE_MODEL_ID=your_seedance_2_5_model_or_endpoint_id
SEED_LLM_MODEL_ID=your_seed_llm_model_or_endpoint_id      # script agent (e.g. seed-2-0-pro-...)

# Voiceover mode B — BytePlus TTS (optional; upload path works without it)
# TTS_BASE_URL=https://.../tts/endpoint
# TTS_MODEL_ID=your_tts_model_id

# Asset group for uploads/reads
ASSET_GROUP_ID=group-20260401144336-bmrf4

# Optional endpoint overrides (defaults target ap-southeast)
# IMAGE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# VIDEO_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# LLM_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Server
PORT=8090
FLASK_DEBUG=true
