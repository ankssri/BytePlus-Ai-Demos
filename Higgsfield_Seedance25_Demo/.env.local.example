# Higgsfield API credentials for the Seedance 2.5 demo.
#
# Copy this file to `.env.local` (which is git-ignored) and fill in your key.
# The value uses the `KEY_ID:KEY_SECRET` format shown in the Higgsfield console.
# Obtain credentials from https://cloud.higgsfield.ai/
#
# IMPORTANT: keep this server-side. Never commit `.env.local` or share the secret.

HF_KEY=YOUR_KEY_ID:YOUR_KEY_SECRET
