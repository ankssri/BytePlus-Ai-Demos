# BytePlus ModelArk API Key
# Obtain from: ModelArk Console → API Keys
ARK_API_KEY=your_api_key_here

# Seedance 2.0 Model ID
# Use the built-in model ID or your custom inference endpoint ID (ep-xxxx)
# Built-in: dreamina-seedance-2-0-260128  (standard quality)
# Built-in: dreamina-seedance-2-0-fast-260128  (faster, lower cost)
SEEDANCE_MODEL_ID=dreamina-seedance-2-0-260128

# Server settings
PORT=5050
FLASK_DEBUG=true
