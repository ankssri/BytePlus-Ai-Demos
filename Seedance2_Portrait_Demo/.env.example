# ── Video Generation API (Bearer token) ─────────────────────────
# Obtain from: ModelArk Console → API Keys
ARK_API_KEY=your_api_key_here

# Seedance 2.0 Model ID
# Built-in: dreamina-seedance-2-0-260128  (standard quality)
# Built-in: dreamina-seedance-2-0-fast-260128  (faster, lower cost)
# Custom:   ep-xxxx  (your inference endpoint)
SEEDANCE_MODEL_ID=dreamina-seedance-2-0-260128

# ── Asset Library APIs (HMAC-SHA256 AK/SK) ──────────────────────
# Obtain from: BytePlus Console → Access Keys
# Required for CreateAssetGroup, CreateAsset, GetAsset
ARK_AK=your_access_key_id_here
ARK_SK=your_secret_access_key_here

# ── Server settings ──────────────────────────────────────────────
PORT=5050
FLASK_DEBUG=true
